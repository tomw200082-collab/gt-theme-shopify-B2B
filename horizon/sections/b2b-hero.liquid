{%- comment -%}
  B2B Hero — GT Everyday (Horizon) · "טקס" Matcha Minimalism.
  Split hero: copy + framed lifestyle image, with hairline value-prop columns below.
  Editable via theme editor. Image source: section setting (image_picker) overrides
  the bundled asset default (gt-hero-energy.webp/.jpg). show_image=false → centered text hero.
{%- endcomment -%}

{%- assign sid = section.id -%}
{%- assign show_image = section.settings.show_image -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800&family=Assistant:wght@300;400;500;600;700&display=swap">

<section class="b2bhero{% if show_image %} b2bhero--split{% endif %}" data-section-id="{{ sid }}">
  <div class="b2bhero__decor" aria-hidden="true"></div>
  <div class="b2bhero__inner">
    <div class="b2bhero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="b2bhero__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h1 class="b2bhero__title">{{ section.settings.title }}</h1>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="b2bhero__lede">{{ section.settings.subtitle }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a class="b2bhero__cta" href="{{ section.settings.cta_link | default: '#b2b-order' }}">
          {{ section.settings.cta_label }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
        </a>
      {%- endif -%}
    </div>

    {%- if show_image -%}
      <figure class="b2bhero__figure">
        <span class="b2bhero__figure-glow" aria-hidden="true"></span>
        {%- if section.settings.hero_image != blank -%}
          {%- assign hero_alt = section.settings.image_alt | default: section.settings.title -%}
          {{ section.settings.hero_image | image_url: width: 1040 | image_tag:
             widths: '420,560,720,1040',
             sizes: '(max-width: 900px) 92vw, 480px',
             class: 'b2bhero__img',
             loading: 'eager',
             fetchpriority: 'high',
             alt: hero_alt }}
        {%- else -%}
          <picture>
            <source type="image/webp" srcset="{{ 'gt-hero-energy.webp' | asset_url }}">
            <img class="b2bhero__img" src="{{ 'gt-hero-energy.jpg' | asset_url }}"
              width="1040" height="1300"
              alt="{{ section.settings.image_alt | default: 'משקה GT Everyday מוגש בקנקן עם קרח, נענע ופירות טריים' }}"
              loading="eager" fetchpriority="high">
          </picture>
        {%- endif -%}
        {%- if section.settings.image_caption != blank -%}
          <figcaption class="b2bhero__cap">{{ section.settings.image_caption }}</figcaption>
        {%- endif -%}
      </figure>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <ul class="b2bhero__props">
      {%- for block in section.blocks -%}
        <li class="b2bhero__prop" {{ block.shopify_attributes }}>
          <span class="b2bhero__prop-ic">
            {%- case block.settings.icon -%}
              {%- when 'leaf' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 4 13c0-5 4.5-9 16-9 0 8-4 16-11 16Z"/><path d="M4 20c2-4 5-7 9-9"/></svg>
              {%- when 'package' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8l9 5 9-5Z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/></svg>
              {%- when 'truck' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h11v9H3zM14 9h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
              {%- when 'receipt' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h14v18l-3-2-2 2-2-2-2 2-2-2-3 2Z"/><path d="M8 8h8M8 12h8"/></svg>
              {%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6Z"/><path d="m9 12 2 2 4-4"/></svg>
              {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18M3 12h18"/></svg>
            {%- endcase -%}
          </span>
          <span class="b2bhero__prop-tx">
            <strong>{{ block.settings.title }}</strong>
            {%- if block.settings.text != blank -%}<span>{{ block.settings.text }}</span>{%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</section>

{% style %}
  #shopify-section-{{ sid }}{ margin:0; }
  .b2bhero{
    --paper:#f7f3ea; --paper-2:#f1ece0; --card:#fffdf7; --tint:#f1ece0;
    --ink:#22281c; --ink-soft:#3c4534; --muted:#6b7361;
    --g:#3e7a31; --g-deep:#27531d; --g-soft:#5fa24c; --g-wash:#e9f2df;
    --amber:#e08a33; --amber-deep:#c06d1c; --amber-soft:#f3a951;
    --line:#e7e0cf;
    --f-display:'Rubik','Heebo','Noto Sans Hebrew',system-ui,sans-serif;
    --f-body:'Assistant','Noto Sans Hebrew',system-ui,sans-serif;
    --track:.16em;
    position:relative; overflow:hidden; isolation:isolate;
    background:linear-gradient(168deg,#e9f1e1 0%, var(--paper) 50%, #fbeede 100%);
    font-family:var(--f-body); color:var(--ink); -webkit-font-smoothing:antialiased;
    padding:clamp(3rem,7vw,6.5rem) clamp(1.25rem,5vw,4rem) 0; text-align:center;
  }
  .b2bhero__decor{ position:absolute; inset:0; z-index:-1; pointer-events:none;
    background:
      radial-gradient(42% 52% at 84% 2%, rgba(95,162,76,.22), transparent 70%),
      radial-gradient(40% 48% at 8% 96%, rgba(224,138,51,.16), transparent 70%); }
  .b2bhero__inner{ max-width:1240px; margin-inline:auto; }
  .b2bhero__copy{ min-width:0; }
  .b2bhero__eyebrow{ display:inline-flex; align-items:center; gap:.55em;
    font-size:.74rem; font-weight:700; letter-spacing:var(--track); color:var(--g-deep);
    background:rgba(255,255,255,.72); border:1px solid #cfe3c0; border-radius:999px;
    padding:.55em 1.2em; margin-bottom:1.5rem; backdrop-filter:blur(6px); }
  .b2bhero__title{ font-family:var(--f-display); font-weight:800; font-size:clamp(2.3rem,6vw,4.4rem);
    line-height:1.04; letter-spacing:-.025em; margin:0 0 1.1rem; color:var(--ink); }
  .b2bhero__lede{ font-size:clamp(1.08rem,1.6vw,1.32rem); line-height:1.55; color:var(--ink-soft);
    font-weight:400; max-width:40ch; margin:0 auto 2rem; }
  .b2bhero__cta{ display:inline-flex; align-items:center; gap:.6em; text-decoration:none;
    background:linear-gradient(135deg,var(--amber-soft),var(--amber)); color:#fff;
    font-family:var(--f-display); font-weight:600; font-size:1.05rem;
    padding:.95em 2.1rem; border-radius:14px; box-shadow:0 10px 26px -6px rgba(192,109,28,.5);
    transition:transform .2s, box-shadow .2s, background .25s, gap .25s; }
  .b2bhero__cta:hover{ transform:translateY(-2px); gap:.85em;
    background:linear-gradient(135deg,var(--amber),var(--amber-deep));
    box-shadow:0 14px 32px -8px rgba(192,109,28,.55); }
  .b2bhero__cta svg{ width:18px; height:18px; }

  /* split layout */
  .b2bhero--split{ text-align:start; }
  .b2bhero--split .b2bhero__inner{ display:grid; grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);
    gap:clamp(2rem,5vw,4.5rem); align-items:center; }
  .b2bhero--split .b2bhero__lede{ margin-inline:0; max-width:42ch; }

  /* figure — rounded image on a warm glow */
  .b2bhero__figure{ position:relative; margin:0; }
  .b2bhero__figure-glow{ position:absolute; inset:-8% -6% -6% -8%; z-index:-1; border-radius:40px;
    background:radial-gradient(58% 58% at 50% 34%, rgba(95,162,76,.30), transparent 72%); filter:blur(10px); }
  .b2bhero__img{ display:block; width:100%; aspect-ratio:4/5; object-fit:cover; border-radius:28px;
    background:var(--tint); box-shadow:0 26px 60px -22px rgba(34,40,28,.42), 0 4px 14px -4px rgba(34,40,28,.14); }
  .b2bhero__cap{ position:absolute; inset-block-end:18px; inset-inline-start:18px; z-index:3;
    background:rgba(255,253,247,.92); border:1px solid var(--line); border-radius:999px;
    padding:.55em 1.1em; font-size:.72rem; font-weight:600; letter-spacing:.04em; color:var(--muted);
    box-shadow:0 6px 16px -6px rgba(34,40,28,.25); backdrop-filter:blur(6px); }
  .b2bhero__cap b{ color:var(--g); font-weight:700; }

  /* value props — rounded glass cards */
  .b2bhero__props{ list-style:none; margin:clamp(2.6rem,5vw,4rem) auto 0; padding:0;
    display:flex; gap:1rem; flex-wrap:wrap; justify-content:center; max-width:1240px; }
  .b2bhero--split .b2bhero__props{ justify-content:flex-start; }
  .b2bhero__prop{ flex:1 1 260px; min-width:0; max-width:380px; display:flex; gap:1rem; align-items:flex-start;
    text-align:start; background:rgba(255,253,247,.78); border:1px solid var(--line); border-radius:18px;
    padding:1.15rem 1.25rem; box-shadow:0 6px 20px -10px rgba(34,40,28,.16); backdrop-filter:blur(6px);
    transition:transform .22s, box-shadow .22s; }
  .b2bhero__prop:hover{ transform:translateY(-3px); box-shadow:0 14px 30px -12px rgba(34,40,28,.22); }
  .b2bhero__prop-ic{ flex:0 0 48px; width:48px; height:48px; border-radius:14px;
    display:flex; align-items:center; justify-content:center; color:#fff;
    background:linear-gradient(145deg,var(--g-soft),var(--g-deep)); box-shadow:0 4px 12px -3px rgba(39,83,29,.4); }
  .b2bhero__prop-ic svg{ width:24px; height:24px; }
  .b2bhero__prop-tx{ display:flex; flex-direction:column; gap:.3rem; min-width:0; }
  .b2bhero__prop-tx strong{ font-family:var(--f-display); font-weight:600; font-size:1.05rem; color:var(--ink); }
  .b2bhero__prop-tx span{ font-size:.88rem; line-height:1.5; color:var(--muted); }

  @media (max-width:900px){
    .b2bhero--split{ text-align:center; }
    .b2bhero--split .b2bhero__inner{ grid-template-columns:1fr; gap:2.4rem; }
    .b2bhero--split .b2bhero__lede{ margin-inline:auto; }
    .b2bhero--split .b2bhero__copy{ order:1; }
    .b2bhero--split .b2bhero__figure{ order:2; width:100%; max-width:420px; margin-inline:auto; }
    .b2bhero--split .b2bhero__img{ aspect-ratio:5/4; }
    .b2bhero--split .b2bhero__props{ justify-content:center; }
  }
  @media (max-width:600px){ .b2bhero__prop{ flex:1 1 100%; max-width:none; } }
  @media (prefers-reduced-motion:reduce){ .b2bhero__cta, .b2bhero__prop{ transition:none; } }
{% endstyle %}

{% schema %}
{
  "name": "B2B Hero",
  "tag": "section",
  "class": "b2b-hero-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "תווית עליונה", "default": "מכירות לעסקים · B2B" },
    { "type": "text", "id": "title", "label": "כותרת ראשית", "default": "GT Everyday לעסקים" },
    { "type": "textarea", "id": "subtitle", "label": "תת כותרת", "default": "משקאות טבעיים לבתי קפה, מסעדות ואירועים — ישירות מהיצרן, במחיר אחיד ושקוף" },
    { "type": "text", "id": "cta_label", "label": "טקסט כפתור", "default": "להרכבת הזמנה" },
    { "type": "text", "id": "cta_link", "label": "קישור כפתור", "default": "#b2b-order" },
    { "type": "header", "content": "תמונה" },
    { "type": "checkbox", "id": "show_image", "label": "הצגת תמונת Hero", "default": true },
    { "type": "image_picker", "id": "hero_image", "label": "תמונת Hero", "info": "ריק = תמונת ברירת המחדל המצורפת לתבנית. יחס מומלץ 4:5 (לאורך)." },
    { "type": "text", "id": "image_alt", "label": "טקסט חלופי לתמונה (alt)" },
    { "type": "text", "id": "image_caption", "label": "כיתוב על התמונה", "default": "תוצרת בית · שרשרת אספקה מלאה" }
  ],
  "blocks": [
    {
      "name": "יתרון",
      "type": "prop",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "אייקון", "default": "leaf",
          "options": [
            { "value": "leaf", "label": "עלה" },
            { "value": "package", "label": "חבילה" },
            { "value": "truck", "label": "משלוח" },
            { "value": "receipt", "label": "חשבונית" },
            { "value": "shield", "label": "מגן" }
          ]
        },
        { "type": "text", "id": "title", "label": "כותרת", "default": "יתרון" },
        { "type": "text", "id": "text", "label": "תיאור" }
      ]
    }
  ],
  "presets": [
    {
      "name": "B2B Hero",
      "blocks": [
        { "type": "prop", "settings": { "icon": "leaf", "title": "טבעי וישיר מהיצרן", "text": "תוצרת טבעית באיכות גבוהה, בלי מתווכים" } },
        { "type": "prop", "settings": { "icon": "package", "title": "הכל מספק אחד", "text": "תה, סנגריה, מאצ'ה, סמודי ואביזרים בהזמנה אחת" } },
        { "type": "prop", "settings": { "icon": "receipt", "title": "נוחות תפעולית", "text": "הזמנה מהירה, תשלום מאובטח וחשבונית מס" } }
      ]
    }
  ]
}
{% endschema %}
