{%- comment -%}
  B2B Order Form v2 — GT Everyday (Horizon)
  זרימה: בחירת מוצרים → ולידציה → מודאל סיכום → demo/live.
  חוזה ההעברה (stub עד G3): POST {webhook_url} JSON —
  { source:"b2b-landing", idempotencyKey, createdAt,
    items:[{sku,title,qty,unitPriceILS,lineTotalILS}], totalILS,
    customer:{businessName,companyId,contactName,phone,email,city,street,notes} }
  תשובה: 200 {"paymentUrl":"https://..."} → redirect לדף הסליקה של חשבונית ירוקה.
  mode="demo" (ברירת מחדל) = אין קריאת רשת; G3 = mode→live + webhook_url.
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Assistant:wght@400;600;700&family=Frank+Ruhl+Libre:wght@500;700&display=swap">
{{ 'b2b-order-form.css' | asset_url | stylesheet_tag }}

<section id="b2b-order" class="b2bof" data-section-id="{{ section.id }}">
  <span id="order" aria-hidden="true"></span>
  <script type="application/json" data-b2bof-config>
    {
      "mode": {{ section.settings.mode | default: 'demo' | json }},
      "webhookUrl": {{ section.settings.webhook_url | default: '' | json }},
      "successPath": {{ section.settings.success_path | default: '/pages/b2b-thank-you' | json }},
      "minOrderILS": {% if section.settings.min_order_ils != blank and section.settings.min_order_ils > 0 %}{{ section.settings.min_order_ils }}{% else %}null{% endif %},
      "whatsapp": {{ section.settings.whatsapp | default: '' | json }}
    }
  </script>

  <div class="b2bof__container">
    <header class="b2bof__head">
      {%- if section.settings.title != blank -%}
        <h2 class="b2bof__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.sub_title != blank -%}
        <p class="b2bof__sub">{{ section.settings.sub_title }}</p>
      {%- endif -%}
    </header>

    <div class="b2bof__toolbar">
      <div class="b2bof__search">
        <input type="search" placeholder="חיפוש מוצר או מק&quot;ט…" aria-label="חיפוש מוצר">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </div>
      <nav class="b2bof__nav" aria-label="קפיצה לקבוצת מוצרים">
        {%- for block in section.blocks -%}
          {%- if block.type == 'group' and block.settings.nav_label != blank -%}
            <a href="#b2bof-g-{{ block.id }}">{{ block.settings.nav_label }}</a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    </div>

    <div class="b2bof__restore" hidden>
      <span>שחזרנו את ההזמנה הקודמת שלך</span>
      <button type="button">נקה והתחל מחדש</button>
    </div>

    <form id="b2bofForm-{{ section.id }}" class="b2bof__form" novalidate>
      <input type="text" name="website" class="b2bof__hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;inset-inline-start:-9999px;opacity:0;height:0;">

      {%- assign grid_open = false -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'group' -%}
            {%- if grid_open -%}</div>{%- assign grid_open = false -%}{%- endif -%}
            <div class="b2bof__group-head" id="b2bof-g-{{ block.id }}" {{ block.shopify_attributes }}>
              <h3 class="b2bof__group-title">{{ block.settings.title }}</h3>
              {%- if block.settings.subtitle != blank -%}
                <span class="b2bof__group-sub">{{ block.settings.subtitle }}</span>
              {%- endif -%}
            </div>
            <div class="b2bof__grid">
            {%- assign grid_open = true -%}
          {%- when 'product' -%}
            {%- assign p = block.settings.product -%}
            {%- if p != blank -%}
              {%- unless grid_open -%}<div class="b2bof__grid">{%- assign grid_open = true -%}{%- endunless -%}
              {%- assign v = p.selected_or_first_available_variant | default: p.variants.first -%}
              <div class="b2bof__card"
                data-pid="{{ p.id }}" data-vid="{{ v.id }}"
                data-sku="{{ v.sku | escape }}" data-title="{{ p.title | escape }}"
                data-price="{{ v.price }}" {{ block.shopify_attributes }}>
                <div class="b2bof__img">
                  {%- if p.featured_image != blank -%}
                    <img src="{{ p.featured_image | image_url: width: 208, height: 208, crop: 'center' }}"
                      alt="{{ p.featured_image.alt | default: p.title | escape }}"
                      loading="lazy" width="104" height="104" style="aspect-ratio:1/1;">
                  {%- endif -%}
                </div>
                <div class="b2bof__info">
                  <span class="b2bof__name">{{ p.title }}</span>
                  {%- if v.sku != blank -%}<span class="b2bof__sku"><bdi>{{ v.sku }}</bdi></span>{%- endif -%}
                  <span class="b2bof__price num"><bdi>{{ v.price | money }}</bdi> ליחידה{% if block.settings.note != blank %} · {{ block.settings.note }}{% endif %}</span>
                  <span class="b2bof__line-total num" aria-live="off"></span>
                </div>
                <div class="b2bof__qty">
                  <button type="button" class="b2bof__step" data-step="-1" aria-label="הפחתת כמות — {{ p.title | escape }}">&minus;</button>
                  <input type="text" class="b2bof__qty-input" inputmode="numeric" pattern="[0-9]*" maxlength="3" value="0" aria-label="כמות — {{ p.title | escape }}">
                  <button type="button" class="b2bof__step" data-step="1" aria-label="הוספת כמות — {{ p.title | escape }}">+</button>
                </div>
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
      {%- if grid_open -%}</div>{%- endif -%}

      <p class="b2bof__empty" hidden>לא נמצאו מוצרים מתאימים — נסו חיפוש אחר</p>

      <fieldset class="b2bof__biz">
        <legend class="b2bof__biz-title">פרטי העסק והאספקה</legend>
        <div class="b2bof__fields">
          <label class="b2bof__field"><span>שם העסק *</span>
            <input type="text" name="company" required autocomplete="organization" aria-describedby="b2bof-err-company">
            <p class="b2bof__field-err" id="b2bof-err-company" aria-live="polite"></p></label>
          <label class="b2bof__field"><span>ח.פ / עוסק מורשה *</span>
            <input type="text" name="business_id" required inputmode="numeric" maxlength="9" dir="ltr" aria-describedby="b2bof-err-business_id">
            <p class="b2bof__field-err" id="b2bof-err-business_id" aria-live="polite"></p></label>
          <label class="b2bof__field"><span>איש קשר *</span>
            <input type="text" name="contact_name" required autocomplete="name" aria-describedby="b2bof-err-contact_name">
            <p class="b2bof__field-err" id="b2bof-err-contact_name" aria-live="polite"></p></label>
          <label class="b2bof__field"><span>טלפון *</span>
            <input type="tel" name="phone" required autocomplete="tel" dir="ltr" aria-describedby="b2bof-err-phone">
            <p class="b2bof__field-err" id="b2bof-err-phone" aria-live="polite"></p></label>
          <label class="b2bof__field"><span>אימייל *</span>
            <input type="email" name="email" required autocomplete="email" dir="ltr" aria-describedby="b2bof-err-email">
            <p class="b2bof__field-err" id="b2bof-err-email" aria-live="polite"></p></label>
          <label class="b2bof__field"><span>עיר *</span>
            <input type="text" name="city" required autocomplete="address-level2" aria-describedby="b2bof-err-city">
            <p class="b2bof__field-err" id="b2bof-err-city" aria-live="polite"></p></label>
          <label class="b2bof__field"><span>רחוב ומספר *</span>
            <input type="text" name="street" required autocomplete="street-address" aria-describedby="b2bof-err-street">
            <p class="b2bof__field-err" id="b2bof-err-street" aria-live="polite"></p></label>
          <label class="b2bof__field b2bof__field--wide"><span>הערות לאספקה</span>
            <textarea name="notes" rows="2"></textarea></label>
        </div>
      </fieldset>

      <p class="b2bof__msg" role="alert" aria-live="polite" hidden></p>

      <div class="b2bof__bar">
        <div class="b2bof__totals" aria-live="polite">
          <span class="b2bof__count">0 פריטים</span>
          <strong class="b2bof__sum num">‏0.00 ₪</strong>
          <p class="b2bof__vat">המחירים כוללים מע״מ · חשבונית מס תופק אוטומטית למייל</p>
        </div>
        <div class="b2bof__minbar" hidden>
          <p class="b2bof__minbar-label"></p>
          <div class="b2bof__minbar-track"><div class="b2bof__minbar-fill"></div></div>
        </div>
        <button type="submit" class="b2bof__submit b2bof__submit--bar">{{ section.settings.submit_label | default: 'המשך לתשלום' }}</button>
      </div>
      {%- if section.settings.mode != 'live' and section.settings.demo_note != blank -%}
        <p class="b2bof__demo-note">{{ section.settings.demo_note }}</p>
      {%- endif -%}
    </form>

    <div class="b2bof__overlay" hidden>
      <div class="b2bof__dialog" role="dialog" aria-modal="true" aria-label="סיכום הזמנה" tabindex="-1">
        <h3 class="b2bof__dialog-title">סיכום ההזמנה</h3>
        <p class="b2bof__dialog-sub">רגע לפני התשלום — ודאו שהכל נכון:</p>
        <div class="b2bof__demo-flag" hidden>מצב הדגמה — ההזמנה תוצג לסיכום בלבד ולא תחויב.</div>
        <table class="b2bof__sum-table">
          <thead><tr><th>מוצר</th><th class="num">כמות</th><th class="num">ליחידה</th><th class="num">סה"כ</th></tr></thead>
          <tbody></tbody>
        </table>
        <div class="b2bof__sum-biz">
          <button type="button" class="b2bof__edit-biz">עריכה</button>
          <div class="b2bof__sum-biz-body"></div>
        </div>
        <details class="b2bof__payload-wrap" hidden>
          <summary>פרטי השליחה הטכניים (demo)</summary>
          <pre class="b2bof__payload"></pre>
        </details>
        <label class="b2bof__confirm">
          <input type="checkbox">
          <span>אני מאשר/ת את פרטי ההזמנה</span>
        </label>
        <p class="b2bof__modal-msg b2bof__msg" role="alert" aria-live="polite" hidden></p>
        <div class="b2bof__dialog-actions">
          <button type="button" class="b2bof__submit b2bof__submit--modal">
            <span class="b2bof__spinner" hidden></span>
            <span class="b2bof__submit-label">אישור ושליחה</span>
          </button>
          <button type="button" class="b2bof__cancel">חזרה לעריכה</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="{{ 'b2b-order-form.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "B2B Order Form",
  "tag": "section",
  "class": "b2b-order-form-section",
  "max_blocks": 50,
  "settings": [
    {
      "type": "paragraph",
      "content": "טופס הזמנה סיטונאית. mode=demo — אין סליקה; ל-G3: להחליף ל-live ולהדביק Webhook."
    },
    { "type": "text", "id": "title", "label": "כותרת", "default": "הרכיבו הזמנה לעסק" },
    { "type": "text", "id": "sub_title", "label": "תת כותרת", "default": "בחרו כמויות, מלאו את פרטי העסק והמשיכו לתשלום מאובטח" },
    { "type": "text", "id": "submit_label", "label": "טקסט כפתור", "default": "המשך לתשלום" },
    {
      "type": "select",
      "id": "mode",
      "label": "מצב פעולה",
      "options": [
        { "value": "demo", "label": "הדגמה (ללא סליקה)" },
        { "value": "live", "label": "חי (שולח ל-Webhook)" }
      ],
      "default": "demo",
      "info": "להעביר ל-live רק אחרי אישור G3 והזנת Webhook."
    },
    {
      "type": "text",
      "id": "webhook_url",
      "label": "Webhook URL (Make.com → חשבונית ירוקה)",
      "info": "ריק = מצב הדגמה גם אם mode=live."
    },
    { "type": "text", "id": "success_path", "label": "נתיב עמוד תודה", "default": "/pages/b2b-thank-you" },
    {
      "type": "number",
      "id": "min_order_ils",
      "label": "מינימום הזמנה בש\"ח",
      "info": "ריק או 0 = ללא מינימום. [טום]"
    },
    {
      "type": "text",
      "id": "whatsapp",
      "label": "מספר וואטסאפ (פורמט בינלאומי)",
      "default": "9725XXXXXXXX",
      "info": "ל-fallback בתקלת תשלום. [טום] להחליף למספר אמיתי."
    },
    {
      "type": "text",
      "id": "demo_note",
      "label": "הערת מצב הדגמה",
      "default": "מערכת התשלום בהקמה — ההזמנה תוצג לסיכום בלבד ולא תחויב."
    }
  ],
  "blocks": [
    {
      "name": "קבוצת מוצרים",
      "type": "group",
      "settings": [
        { "type": "text", "id": "title", "label": "שם הקבוצה", "default": "קבוצה" },
        { "type": "text", "id": "subtitle", "label": "תיאור קצר" },
        { "type": "text", "id": "nav_label", "label": "תווית בניווט המהיר", "info": "ריק = הקבוצה לא תופיע בניווט העליון" }
      ]
    },
    {
      "name": "מוצר",
      "type": "product",
      "settings": [
        { "type": "product", "id": "product", "label": "מוצר" },
        { "type": "text", "id": "note", "label": "הערה (מוצגת ליד המחיר)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "B2B Order Form",
      "blocks": [
        { "type": "group", "settings": { "title": "המוצרים שלנו" } },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
