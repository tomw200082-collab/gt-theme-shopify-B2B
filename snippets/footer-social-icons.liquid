{%- if enable_social -%}
	{%- assign social_icons = false -%}
	{%- if
	  settings.social_twitter_link != blank
	  or settings.social_facebook_link != blank
	  or settings.social_pinterest_link != blank
	  or settings.social_instagram_link != blank
	  or settings.social_tumblr_link != blank
	  or settings.social_snapchat_link != blank
	  or settings.social_youtube_link != blank
	  or settings.social_vimeo_link != blank
	-%}
	  {%- assign social_icons = true -%}
	{%- endif -%}
	{%- if template.name == 'article' or template.name == 'blog' -%}
		{%- if block.settings.enable_rss -%}
			{%- assign social_icons = true -%}
		{%- endif -%}
	{%- endif -%}
	{%- if social_icons -%}
  	<div class="col-xs-12 no-gutter footer__social-icons">
  		<ul class="list--inline social-icons{% if show_network_name %} social-icons--network{% endif %}"{% unless has_content %} style="margin-top:0;"{% endunless %}>
        {% if settings.social_facebook_link != blank %}
          <li>
            <a class="social-icons__link{% if show_network_name %} social-icons__links-network{% endif %}{% if custom_link_class %} {{ custom_link_class }}{% endif %}" href="{{ settings.social_facebook_link | escape }}" title="{{ 'layout.footer.social_platform' | t: name: shop.name, platform: 'Facebook' }}">
              {% render 'icon-facebook' %}
              {%- if show_network_name -%}<span>{{ 'general.social.facebook' | t }}</span>{%- endif -%}
            </a>
          </li>
        {% endif %}
        {% if settings.social_twitter_link != blank %}
          <li>
            <a class="social-icons__link{% if show_network_name %} social-icons__links-network{% endif %}{% if custom_link_class %} {{ custom_link_class }}{% endif %}" href="{{ settings.social_twitter_link | escape }}" title="{{ 'layout.footer.social_platform' | t: name: shop.name, platform: 'Twitter' }}">
              {% render 'icon-twitter' %}
              {%- if show_network_name -%}<span>{{ 'general.social.twitter' | t }}</span>{%- endif -%}
            </a>
          </li>
        {% endif %}
        {% if settings.social_pinterest_link != blank %}
          <li>
            <a class="social-icons__link{% if show_network_name %} social-icons__links-network{% endif %}{% if custom_link_class %} {{ custom_link_class }}{% endif %}" href="{{ settings.social_pinterest_link | escape }}" title="{{ 'layout.footer.social_platform' | t: name: shop.name, platform: 'Pinterest' }}">
              {% render 'icon-pinterest' %}
              {%- if show_network_name -%}<span>{{ 'general.social.pinterest' | t }}</span>{%- endif -%}
            </a>
          </li>
        {% endif %}
        {% if settings.social_instagram_link != blank %}
          <li>
            <a class="social-icons__link{% if show_network_name %} social-icons__links-network{% endif %}{% if custom_link_class %} {{ custom_link_class }}{% endif %}" href="{{ settings.social_instagram_link | escape }}" title="{{ 'layout.footer.social_platform' | t: name: shop.name, platform: 'Instagram' }}">
              {% render 'icon-instagram' %}
              {%- if show_network_name -%}<span>{{ 'general.social.instagram' | t }}</span>{%- endif -%}
            </a>
          </li>
        {% endif %}
        {% if settings.social_tumblr_link != blank %}
          <li>
            <a class="social-icons__link{% if show_network_name %} social-icons__links-network{% endif %}{% if custom_link_class %} {{ custom_link_class }}{% endif %}" href="{{ settings.social_tumblr_link | escape }}" title="{{ 'layout.footer.social_platform' | t: name: shop.name, platform: 'Tumblr' }}">
              {% render 'icon-tumblr' %}
              {%- if show_network_name -%}<span>{{ 'general.social.tumblr' | t }}</span>{%- endif -%}
            </a>
          </li>
        {% endif %}
        {% if settings.social_snapchat_link != blank %}
          <li>
            <a class="social-icons__link{% if show_network_name %} social-icons__links-network{% endif %}{% if custom_link_class %} {{ custom_link_class }}{% endif %}" href="{{ settings.social_snapchat_link | escape }}" title="{{ 'layout.footer.social_platform' | t: name: shop.name, platform: 'Snapchat' }}">
              {% render 'icon-snapchat' %}
              {%- if show_network_name -%}<span>{{ 'general.social.snapchat' | t }}</span>{%- endif -%}
            </a>
          </li>
        {% endif %}
        {% if settings.social_youtube_link != blank %}
          <li>
            <a class="social-icons__link{% if show_network_name %} social-icons__links-network{% endif %}{% if custom_link_class %} {{ custom_link_class }}{% endif %}" href="{{ settings.social_youtube_link | escape }}" title="{{ 'layout.footer.social_platform' | t: name: shop.name, platform: 'YouTube' }}">
              {%- if show_network_name -%}
                {% render 'icon-youtube' with style: 'vertical-align:middle;' %}
                <span>{{ 'general.social.youtube' | t }}</span>
              {%- else -%}
                {% render 'icon-youtube' %}  
              {%- endif -%}
            </a>
          </li>
        {% endif %}
        {% if settings.social_vimeo_link != blank %}
          <li>
            <a class="social-icons__link{% if show_network_name %} social-icons__links-network{% endif %}{% if custom_link_class %} {{ custom_link_class }}{% endif %}" href="{{ settings.social_vimeo_link | escape }}" title="{{ 'layout.footer.social_platform' | t: name: shop.name, platform: 'Vimeo' }}">
              {% render 'icon-vimeo' %}
              {%- if show_network_name -%}<span>{{ 'general.social.vimeo' | t }}</span>{%- endif -%}
            </a>
          </li>
        {% endif %}
        {% if template.name == 'blog' or template.name == 'article' %}
        	{%- if block.settings.enable_rss -%}
          <li>
            <a class="social-icons__link{% if show_network_name %} social-icons__links-network{% endif %}{% if custom_link_class %} {{ custom_link_class }}{% endif %}" href="{{ shop.url }}{{ blog.url }}.atom">
              {% render 'icon-rss' %}
              {%- if show_network_name -%}<span>{{ 'general.social.rss' | t }}</span>{%- endif -%}
            </a>
          </li>
          {%- endif -%}
        {% endif %}
      </ul>
  	</div>
  {%- endif -%}
{%- endif -%}