    "b2b_faq": {
      "type": "faq",
      "blocks": {
        "q1": {
          "type": "faq_item",
          "settings": {
            "title": "למי מיועדת ההזמנה העסקית?",
            "content": "<p>לבתי קפה, מסעדות, ברים, מלונות, משרדים ומפיקי אירועים — כל עסק שרוצה משקאות טבעיים באיכות גבוהה, ישירות מהיצרן.</p>"
          }
        },
        "q2": {
          "type": "faq_item",
          "settings": {
            "title": "האם המחירים שונים בין עסקים?",
            "content": "<p>לא. המחיר באתר אחיד ושקוף לכל העסקים — בלי מיקוח ובלי מחירונים נסתרים.</p>"
          }
        },
        "q3": {
          "type": "faq_item",
          "settings": {
            "title": "איך מתבצע התשלום ומה לגבי חשבונית?",
            "content": "<p>לאחר שליחת ההזמנה תועברו לדף תשלום מאובטח. חשבונית מס מופקת אוטומטית ונשלחת אליכם במייל.</p>"
          }
        },
        "q4": {
          "type": "faq_item",
          "settings": {
            "title": "שלחתי הזמנה — מה הלאה?",
            "content": "<p>ניצור איתכם קשר לתיאום האספקה. לכל שאלה אפשר לפנות אלינו דרך טופס יצירת הקשר שבתחתית הדף.</p>"
          }
        }
      },
